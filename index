<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Thornberry — Platform</title>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Playfair+Display:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

  :root {
    --white: #f8f7f4;
    --black: #0a0a0a;
    --dark: #111113;
    --accent: #c5a74e;
    --teal: #1a1a1e;
    --font-main: 'Outfit', sans-serif;
    --font-display: 'Playfair Display', Georgia, serif;
    --font-mono: 'Space Mono', monospace;
  }

  html { font-size: 16px; scroll-behavior: smooth; }
  body {
    font-family: var(--font-main);
    background: var(--black);
    color: var(--white);
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
  }

  /* ── NAV ── */
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px 48px;
    background: rgba(10,10,10,0.85);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }
  .logo {
    font-family: var(--font-mono);
    font-size: 1rem;
    letter-spacing: 0.45em;
    font-weight: 700;
    color: var(--white);
    text-transform: uppercase;
    text-decoration: none;
  }
  .nav-center {
    display: flex;
    gap: 36px;
    list-style: none;
  }
  .nav-center a {
    color: var(--white);
    text-decoration: none;
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    font-weight: 500;
    opacity: 0.6;
    transition: opacity 0.3s;
  }
  .nav-center a:hover { opacity: 1; }
  .nav-cta {
    padding: 10px 28px;
    border: 1.5px solid rgba(255,255,255,0.25);
    color: var(--white);
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    transition: all 0.3s;
  }
  .nav-cta:hover {
    background: var(--white);
    color: var(--black);
    border-color: var(--white);
  }
  .nav-toggle {
    display: none;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--white);
    opacity: 0.7;
    cursor: pointer;
  }

  /* ── HERO: PHONE + RINGS ── */
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    position: relative;
    overflow: hidden;
    padding: 120px 40px 80px;
    background: var(--dark);
  }

  /* Back link */
  .back-link {
    position: absolute;
    top: 100px;
    left: 48px;
    display: flex;
    align-items: center;
    gap: 8px;
    color: rgba(255,255,255,0.5);
    text-decoration: none;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    transition: color 0.3s;
    z-index: 10;
  }
  .back-link:hover { color: var(--white); }
  .back-link svg { width: 16px; height: 16px; }

  /* Rings */
  .hero-rings {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 800px; height: 800px;
    pointer-events: none;
    animation: heroRingsRotate 40s linear infinite;
  }
  @keyframes heroRingsRotate {
    from { transform: translate(-50%, -50%) rotate(0deg); }
    to { transform: translate(-50%, -50%) rotate(360deg); }
  }
  .hero-ring {
    position: absolute;
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 50%;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    animation: heroRingPulse 7s ease-in-out infinite;
  }
  .hero-ring:nth-child(1) { width: 320px; height: 320px; animation-delay: 0s; }
  .hero-ring:nth-child(2) { width: 480px; height: 480px; animation-delay: 1s; }
  .hero-ring:nth-child(3) { width: 640px; height: 640px; animation-delay: 2s; }
  .hero-ring:nth-child(4) { width: 800px; height: 800px; animation-delay: 3s; }
  @keyframes heroRingPulse {
    0%, 100% { opacity: 0.4; }
    50% { opacity: 1; }
  }

  /* Floating labels around hero */
  .hero-label {
    position: absolute;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.25);
    font-weight: 500;
    z-index: 2;
  }
  .hl-1 { top: 18%; left: 38%; }
  .hl-2 { top: 32%; right: 14%; }
  .hl-3 { bottom: 28%; left: 10%; }
  .hl-4 { bottom: 14%; right: 18%; }

  /* Phone */
  .hero-phone {
    position: relative;
    z-index: 5;
    width: 240px;
    height: 480px;
    background: linear-gradient(145deg, #1a1a1c 0%, #0e0e10 100%);
    border-radius: 36px;
    border: 2.5px solid rgba(255,255,255,0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 60px 120px rgba(0,0,0,0.6), 0 0 0 1px rgba(255,255,255,0.04);
    overflow: hidden;
    margin-bottom: 32px;
    opacity: 0;
    animation: phoneIn 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.2s forwards;
  }
  @keyframes phoneIn {
    from { opacity: 0; transform: translateY(40px) scale(0.94); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  .hero-phone::before {
    content: '';
    position: absolute;
    top: 14px;
    left: 50%;
    transform: translateX(-50%);
    width: 80px;
    height: 22px;
    background: #000;
    border-radius: 12px;
    z-index: 10;
  }
  .phone-inner {
    width: calc(100% - 10px);
    height: calc(100% - 10px);
    border-radius: 32px;
    background: linear-gradient(180deg, #1c2333 0%, #0f1520 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 48px 16px 16px;
    gap: 10px;
  }
  .phone-brand {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.4em;
    color: var(--accent);
    margin-bottom: 8px;
    text-transform: uppercase;
  }
  .phone-row {
    display: flex;
    gap: 8px;
    width: 100%;
  }
  .phone-tile {
    flex: 1;
    height: 60px;
    border-radius: 10px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.06);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
  }
  .phone-tile-icon {
    width: 18px; height: 18px;
    border-radius: 4px;
    background: rgba(197,167,78,0.2);
  }
  .phone-tile-text {
    font-size: 0.4rem;
    color: rgba(255,255,255,0.4);
    letter-spacing: 0.05em;
  }
  .phone-card-lg {
    width: 100%;
    height: 90px;
    border-radius: 12px;
    background: linear-gradient(135deg, rgba(197,167,78,0.12) 0%, rgba(197,167,78,0.04) 100%);
    border: 1px solid rgba(197,167,78,0.1);
  }
  .phone-card-sm {
    width: 100%;
    height: 50px;
    border-radius: 10px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.05);
  }
  .phone-nav {
    margin-top: auto;
    width: 100%;
    display: flex;
    justify-content: space-around;
    padding: 10px 0 4px;
    border-top: 1px solid rgba(255,255,255,0.06);
  }
  .phone-nav-dot {
    width: 20px; height: 20px;
    border-radius: 6px;
    background: rgba(255,255,255,0.06);
  }
  .phone-nav-dot.active { background: rgba(197,167,78,0.3); }

  /* Hero text */
  .hero-text {
    position: relative;
    z-index: 5;
  }
  .hero-heading {
    font-size: clamp(2.6rem, 5vw, 4rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: 6px;
    opacity: 0;
    animation: fadeUp 0.9s ease 0.5s forwards;
  }
  .hero-heading em {
    font-style: normal;
    color: var(--accent);
  }
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* ── SOLUTIONS SECTION ── */
  .solutions {
    padding: 100px 48px 120px;
    text-align: center;
    background: var(--black);
  }
  .solutions-heading {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    margin-bottom: 64px;
    color: var(--white);
  }

  /* Circle grid */
  .circles-grid {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 48px;
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Individual circle */
  .solution-circle {
    position: relative;
    width: 260px;
    height: 260px;
    border-radius: 50%;
    background: var(--dark);
    border: 1px solid rgba(255,255,255,0.12);
    cursor: pointer;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94), box-shadow 0.4s ease, border-color 0.4s ease;
    text-decoration: none;
  }
  .solution-circle:hover {
    transform: scale(1.05);
    box-shadow: 0 12px 48px rgba(0, 0, 0, 0.4);
    border-color: rgba(255,255,255,0.25);
  }

  /* Gold inset ring */
  .solution-circle::before {
    content: '';
    position: absolute;
    top: 12px; left: 12px; right: 12px; bottom: 12px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.06);
    pointer-events: none;
    z-index: 2;
    transition: border-color 0.4s;
  }
  .solution-circle:hover::before { border-color: rgba(255,255,255,0.12); }

  /* Subtle overlay on hover */
  .solution-circle::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: rgba(0,0,0,0);
    transition: background 0.4s;
    z-index: 1;
  }
  .solution-circle:hover::after {
    background: rgba(255,255,255,0.03);
  }

  /* Default state */
  .circle-default {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 30px;
    opacity: 1;
    transition: opacity 0.4s ease;
    z-index: 3;
  }
  .circle-default h3 {
    font-family: var(--font-display);
    font-size: 1.55rem;
    font-weight: 500;
    color: var(--white);
    line-height: 1.25;
    letter-spacing: 0.02em;
  }

  /* Hover state */
  .circle-hover-content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 36px;
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: 3;
  }
  .circle-hover-content p {
    font-size: 0.92rem;
    font-weight: 400;
    color: var(--white);
    line-height: 1.5;
    margin-bottom: 16px;
    letter-spacing: 0.01em;
  }
  .circle-hover-content .circle-arrow {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    font-weight: 600;
    color: rgba(255,255,255,0.7);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* Key icon */
  .key-icon {
    width: 50px;
    height: 30px;
    margin-bottom: 12px;
  }

  /* Swap on hover */
  .solution-circle:hover .circle-default { opacity: 0; }
  .solution-circle:hover .circle-hover-content { opacity: 1; }

  /* ── FOOTER ── */
  footer {
    padding: 48px;
    text-align: center;
    border-top: 1px solid rgba(255,255,255,0.06);
    color: rgba(255,255,255,0.3);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
  }
  footer a {
    color: var(--accent);
    text-decoration: none;
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    nav { padding: 20px 24px; }
    .nav-center { display: none; }
    .nav-cta { display: none; }
    .nav-toggle { display: block; }
    .solutions { padding: 80px 24px 100px; }
    .circles-grid { gap: 32px; }
    .solution-circle { width: 220px; height: 220px; }
    .circle-default h3 { font-size: 1.3rem; }
    .circle-hover-content p { font-size: 0.82rem; }
    .circle-hover-content { padding: 28px; }
    .back-link { left: 24px; }
    .hero-label { display: none; }
  }
  @media (max-width: 560px) {
    .solution-circle { width: 260px; height: 260px; }
    .circles-grid { gap: 28px; }
  }
</style>
</head>
